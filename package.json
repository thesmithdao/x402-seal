{
  "name": "@cultos/x402-seal",
  "version": "0.1.1",
  "description": "Verify an x402 service through settlement and delivery.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesmithdao/x402-seal.git"
  },
  "bin": {
    "x402-seal": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/cli.ts src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@x402/core": "2.24.0",
    "@x402/evm": "2.24.0",
    "@x402/extensions": "2.24.0",
    "viem": "2.56.5"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
    "vitest": "5.0.0"
  }
}
